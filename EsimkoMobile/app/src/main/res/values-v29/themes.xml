<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 29+ punya scrim otomatis yang bisa dipaksa; navigation bar boleh
         transparan penuh tanpa tombol jadi tak terlihat. -->
    <style name="Theme.EsimkoMobile" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceNavigationBarContrast">true</item>
    </style>
</resources>
